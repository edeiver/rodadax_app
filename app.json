{
  "expo": {
    "name": "Rodadax",
    "slug": "rodadax_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.edeiver.rodadax"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.edeiver.rodadax"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "8700c727-c54a-42a6-91b5-4301b7d19f75"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rodadax usa tu ubicación para mostrarte en el mapa y grabar el recorrido de tu rodada.",
          "locationAlwaysAndWhenInUsePermission": "Rodadax necesita tu ubicación en todo momento para seguir grabando tu rodada aunque bloquees el teléfono o lo lleves en el soporte.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-font",
      "expo-splash-screen"
    ]
  }
}
